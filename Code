run_mediation_df <- function(data, outcomes, exposure,cvar = c("age","interval","sex70","edu","comorbidity","final_pair1"),
                             med, sims = 1000, boot = TRUE, boot.ci.type = "bca",treat.value = 1, control.value = 0, seed = 123456) {
  results <- data.frame()
  cov_str <- paste(cvar, collapse = " + ")
  for (y in outcomes) {
    for (m in med) {
      row_out <- tryCatch({
        model_m <- eval(bquote( lm(.(as.formula(paste0(m, " ~ ", exposure, " + ", cov_str))), data = data) ))
        model_y <- eval(bquote( lm(.(as.formula(paste0(y, " ~ ", exposure, " + ", m, " + ", cov_str))), data = data)  ))
        set.seed(seed)
        mo <- mediation::mediate(model_m, model_y,treat = exposure, mediator = m,
                                 treat.value = treat.value, control.value = control.value,
                                 boot = boot, boot.ci.type = boot.ci.type, sims = sims)
        data.frame(
          exposure = exposure, mediator = m, outcome = y,
          acme = mo$d.avg, acme_lower = mo$d.avg.ci[1], acme_upper = mo$d.avg.ci[2], acme_p = mo$d.avg.p,
          ade  = mo$z.avg, ade_lower  = mo$z.avg.ci[1], ade_upper  = mo$z.avg.ci[2], ade_p  = mo$z.avg.p,
          total = mo$tau.coef, total_lower = mo$tau.ci[1], total_upper = mo$tau.ci[2], total_p = mo$tau.p,
          mediation_prop = mo$n.avg * 100,
          ci_lower = mo$n.avg.ci[1] * 100, ci_upper = mo$n.avg.ci[2] * 100, p = mo$n.avg.p,
          stringsAsFactors = FALSE)  }, error = function(e) {
            message(sprintf("失败: mediator=%s, outcome=%s | 错误: %s", m, y, conditionMessage(e)))
            data.frame(exposure = exposure, mediator = m, outcome = y,
                       acme = NA_real_, acme_lower = NA_real_, acme_upper = NA_real_, acme_p = NA_real_,
                       ade = NA_real_, ade_lower = NA_real_, ade_upper = NA_real_, ade_p = NA_real_,
                       total = NA_real_, total_lower = NA_real_, total_upper = NA_real_, total_p = NA_real_,
                       mediation_prop = NA_real_, ci_lower = NA_real_, ci_upper = NA_real_, p = NA_real_,
                       stringsAsFactors = FALSE)    })
      results <- rbind(results, row_out)   } }
  return(results)}

