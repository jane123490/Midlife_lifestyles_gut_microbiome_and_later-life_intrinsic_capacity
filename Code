  mean_ic <- mean(pred_ic, na.rm = TRUE)
  
  delta_z  <- mean_z - mean_base_z
  delta_ic <- mean_ic - mean_base_ic
  
  pct_change_ic <- (delta_ic / mean_base_ic) * 100
  
  out <- data.frame(scenario = scenario_name,
                    mean_ic_z = mean_z,mean_ic_raw = mean_ic,delta_ic_z = delta_z,delta_ic_raw = delta_ic,pct_change_ic = pct_change_ic)
  return(out)}

