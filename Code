linear_regressions <- function(data) {
  exposures  <- c(species_filtered)
  outcomes   <- c("ic_z", "mmse_z", "sppb_z", "handgrip_z", "sensory_z", "gds_z")
  covariates <- c("age_d70", "as.factor(sex70)","as.factor(edu)","bmi70","comorbidity70","final_pair1","lifestyle")
  
  results <- data.frame(exposure = character(), outcome = character(),beta = numeric(), ci_lower = numeric(), ci_upper = numeric(),
                        p = numeric(), n_nonzero = integer(), n_total = integer(),stringsAsFactors = FALSE)
  n_total_all <- nrow(data)
  
  for (pred in exposures) {
    sub <- data[!is.na(data[[pred]]) & data[[pred]] != 0, , drop = FALSE]
    n_nonzero <- nrow(sub)
    for (out in outcomes) {
      formula_str <- paste0(out, " ~ ", pred, " + ", paste(covariates, collapse = " + "))
      if (n_nonzero < 10) {
        results <- rbind(results,data.frame(exposure = pred, outcome = out, beta = NA, ci_lower = NA,
                ci_upper = NA, p = NA, n_nonzero = n_nonzero, n_total = n_total_all,stringsAsFactors = FALSE))
        next  }
      model <- tryCatch(lm(as.formula(formula_str), data = sub), error = function(e) NULL)
      if (is.null(model) || !(pred %in% rownames(summary(model)$coefficients))) {
        results <- rbind(results, data.frame(exposure = pred, outcome = out, beta = NA, ci_lower = NA,
                  ci_upper = NA, p = NA, n_nonzero = n_nonzero, n_total = n_total_all,stringsAsFactors = FALSE))
        next }
      coef_summary <- summary(model)$coefficients
      beta   <- coef_summary[pred, "Estimate"]
      p_val  <- coef_summary[pred, "Pr(>|t|)"]
      ci     <- confint(model, level = 0.95)
      
      results <- rbind(results,data.frame(exposure = pred, outcome = out, beta = beta,ci_lower = ci[pred, 1], ci_upper = ci[pred, 2], 
                 p = p_val,n_nonzero = n_nonzero, n_total = n_total_all,stringsAsFactors = FALSE))  } }
  return(results)}

