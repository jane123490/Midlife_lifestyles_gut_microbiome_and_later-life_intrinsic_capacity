#计算点估计的函数
run_one_analysis <- function(data, mu_ic, sd_ic, scenario_list) {
  fit <- lm(ic_z ~ smoke_e + alcohol_e + dash_e + activity_e + bmi_e +
              age + interval + as.factor(sex70) + as.factor(edu) + comorbidity,data = data)
  
  base_data <- data
  pred_base_z  <- predict(fit, newdata = base_data)
  pred_base_ic <- z_to_raw_ic(pred_base_z, mu = mu_ic, sd = sd_ic)
  
  mean_base_z  <- mean(pred_base_z, na.rm = TRUE)
  mean_base_ic <- mean(pred_base_ic, na.rm = TRUE)
  
  res_list <- vector("list", length(scenario_list))
  nm <- names(scenario_list)
  
  for (i in seq_along(scenario_list)) {
    vars_to_1 <- scenario_list[[i]]
    scenario_name <- nm[i]
    
    newdata <- data
    for (v in vars_to_1) {newdata[[v]] <- 1 }
    
    pred_z  <- predict(fit, newdata = newdata)
    pred_ic <- z_to_raw_ic(pred_z, mu = mu_ic, sd = sd_ic)
    
    mean_z  <- mean(pred_z, na.rm = TRUE)
    mean_ic <- mean(pred_ic, na.rm = TRUE)
    
    delta_ic_raw  <- mean_ic - mean_base_ic
    pct_change_ic <- (delta_ic_raw / mean_base_ic) * 100
    
    res_list[[i]] <- data.frame(scenario = scenario_name, delta_ic_raw = delta_ic_raw, pct_change_ic = pct_change_ic, stringsAsFactors = F)}
  
  out <- do.call(rbind, res_list)
  rownames(out) <- NULL
  return(out)}

##bootstrap 函数
bootstrap_ci_scenarios <- function(data, mu_ic, sd_ic, scenario_list,B = 1000, seed = 123456) {
  set.seed(seed)
  n <- nrow(data)
  scenario_names <- names(scenario_list)
  n_scn <- length(scenario_names)
  
  boot_delta <- matrix(NA_real_, nrow = B, ncol = n_scn)
  boot_pct   <- matrix(NA_real_, nrow = B, ncol = n_scn)
  colnames(boot_delta) <- scenario_names
  colnames(boot_pct)   <- scenario_names
  
  for (b in 1:B) {
    idx <- sample(seq_len(n), size = n, replace = TRUE)
    boot_data <- data[idx, , drop = FALSE]
    tmp <- try(run_one_analysis(data = boot_data,mu_ic = mu_ic,sd_ic = sd_ic,scenario_list = scenario_list),silent = TRUE)
    
    if (!inherits(tmp, "try-error")) {
      boot_delta[b, tmp$scenario] <- tmp$delta_ic_raw
      boot_pct[b, tmp$scenario]   <- tmp$pct_change_ic} }
  
  ## 计算原始样本点估计
  point_est <- run_one_analysis(data = data,mu_ic = mu_ic,sd_ic = sd_ic,scenario_list = scenario_list)
  
  ## 提取 percentile bootstrap CI
  ci_res <- data.frame(
    scenario = scenario_names,
    delta_ic_raw = NA_real_,
    delta_ic_raw_ci_lower = NA_real_,
    delta_ic_raw_ci_upper = NA_real_,
    pct_change_ic = NA_real_,
    pct_change_ic_ci_lower = NA_real_,
    pct_change_ic_ci_upper = NA_real_,
    stringsAsFactors = FALSE )
  
  for (j in seq_along(scenario_names)) {
    scn <- scenario_names[j]
    
    delta_vec <- boot_delta[, scn]
    pct_vec   <- boot_pct[, scn]
    
    ci_res$delta_ic_raw[j] <- point_est$delta_ic_raw[point_est$scenario == scn]
    ci_res$pct_change_ic[j] <- point_est$pct_change_ic[point_est$scenario == scn]
    
    ci_res$delta_ic_raw_ci_lower[j] <- quantile(delta_vec, probs = 0.025, na.rm = TRUE)
    ci_res$delta_ic_raw_ci_upper[j] <- quantile(delta_vec, probs = 0.975, na.rm = TRUE)
    
    ci_res$pct_change_ic_ci_lower[j] <- quantile(pct_vec, probs = 0.025, na.rm = TRUE)
    ci_res$pct_change_ic_ci_upper[j] <- quantile(pct_vec, probs = 0.975, na.rm = TRUE)}
  return(ci_res)}

