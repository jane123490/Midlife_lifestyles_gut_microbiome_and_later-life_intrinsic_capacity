########查找prevalence位于最高10%并且平均IC位于整个人群平均数以下的生活方式聚集组合
make_pattern_summary <- function(data,smoke = "smoke_e",alcohol = "alcohol_e",dash = "dash_e",activity = "activity_e",bmi = "bmi_e",
                                 ic = "ic",ic_z = "ic_z") {
  df <- data
  vars_needed <- c(smoke, alcohol, dash, activity, bmi, ic, ic_z)
  missing_vars <- vars_needed[!vars_needed %in% names(df)]
  if (length(missing_vars) > 0) {stop(paste("以下变量在数据中不存在：", paste(missing_vars, collapse = ", ")))}
  
  df$pattern <- paste0(df[[smoke]],df[[alcohol]], df[[dash]], df[[activity]],df[[bmi]])
  n_tab <- as.data.frame(table(df$pattern), stringsAsFactors = FALSE)
  names(n_tab) <- c("pattern", "n")
  n_tab$prevalence <- n_tab$n / sum(n_tab$n)
  mean_ic_tab <- aggregate(df[[ic]], by = list(pattern = df$pattern), FUN = mean, na.rm = TRUE)
  names(mean_ic_tab)[2] <- "mean_ic"
  mean_icz_tab <- aggregate(df[[ic_z]], by = list(pattern = df$pattern), FUN = mean, na.rm = TRUE)
  names(mean_icz_tab)[2] <- "mean_ic_z"
  out <- merge(n_tab, mean_ic_tab, by = "pattern", all = TRUE)
  out <- merge(out, mean_icz_tab, by = "pattern", all = TRUE)
  
  out$smoke_e    <- substr(out$pattern, 1, 1)
  out$alcohol_e  <- substr(out$pattern, 2, 2)
  out$dash_e     <- substr(out$pattern, 3, 3)
  out$activity_e <- substr(out$pattern, 4, 4)
  out$bmi_e      <- substr(out$pattern, 5, 5)
  
  out$smoke_e    <- as.numeric(out$smoke_e)
  out$alcohol_e  <- as.numeric(out$alcohol_e)
  out$dash_e     <- as.numeric(out$dash_e)
  out$activity_e <- as.numeric(out$activity_e)
  out$bmi_e      <- as.numeric(out$bmi_e)
  
  out <- out[order(-out$n), ]
  rownames(out) <- NULL
  out <- out[, c("pattern","smoke_e", "alcohol_e", "dash_e", "activity_e", "bmi_e","n", "prevalence", "mean_ic", "mean_ic_z")]
  return(out) }

